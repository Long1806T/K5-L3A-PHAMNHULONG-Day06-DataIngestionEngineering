# Local-only connection for the provided Docker Compose setup.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# psql client used by src/store.py. Without a local psql, use the one inside the container:
# PSQL_BIN=docker exec -i day6_student_starter-postgres-1 psql
PSQL_BIN=psql

# Local ONNX embedding model (no API key needed); see README "Embedding model".
EMBEDDING_MODEL_DIR=models/all-MiniLM-L6-v2-onnx

# Not used by this submission (local model). Never commit real keys.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
